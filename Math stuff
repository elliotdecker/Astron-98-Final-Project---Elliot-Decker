import math
c = 299792458
D = 3e16 # total trip distance
m = 10 # mass

# E total:
E_t = 5e19
# E one way:
E_o = E_t / 2
# Lorentz factor:
y = 1 + E_o / (m * c**2)

v_max = c * math.sqrt(1 - 1/y**2)

d = D / 2

a = (c**2 * (y - 1)) / d

T = (c/a) * math.atanh(v_max/c) # proper time

s = (c**2 / a) * (math.cosh((a * T)/c) - 1) # distance from earth's frame

t = (c/a) * math.sinh((a * T) / c)

t_accel = (v_max * y) / a

print(t / 86400)
print(T / 86400)
print(t_accel / 86400)

print(d)
print(s)

